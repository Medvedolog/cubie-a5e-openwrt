# Target: Radxa Cubie A5E only
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa55=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_sunxi_cortexa55_DEVICE_radxa_cubie-a5e=y

# image
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_SIGNED_PACKAGES=y

# Build the ImageBuilder from this exact patched kernel and package ABI.
# It uses the immutable signed GitHub APK feed of the same firmware commit.
CONFIG_IB=y
# CONFIG_IB_STANDALONE is not set

# DevBuild labels the pinned upstream development tree without claiming
# compatibility with a numbered stable OpenWrt release.
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_NUMBER="DevBuild 001"
CONFIG_VERSION_CODE="A5E"

# ccache is a developer option: it needs DEVEL
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# onboard Wi-Fi: AIC8800D80 (SDIO); Bluetooth is out of scope
CONFIG_PACKAGE_kmod-aic8800-sdio=y
CONFIG_PACKAGE_aic8800-sdio-firmware=y
# CONFIG_AIC8800_SDIO_BT_SUPPORT is not set
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wireless-regdb=y

# First boot: safely extend the mounted ext4 root partition + filesystem.
# Applies to microSD, and to NVMe only if the OS is actually rooted there.
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mtd=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FLASHCP=y

# storage and USB (USB2 host ports; M.2 NVMe on the PCIe/USB3 combo PHY)
# NVMe controller/host built into kernel for root=PARTUUID on PCIe.
# CONFIG_PACKAGE_kmod-nvme is not set
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# Optional USB modem modules: compile signed APKs for the matching feed,
# but keep them OUT of the base image. Dependencies are resolved by OpenWrt.
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=m
CONFIG_PACKAGE_kmod-usb-net-rndis=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=m
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_kmod-usb-acm=m

# web UI and tools for the first hardware report
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nvme-cli=y

# Upstream Radxa Cubie A5E SD profile. Only Wi-Fi (no BT).
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_sunxi_cortexa53_DEVICE_radxa_cubie-a5e=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=256
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_PACKAGE_kmod-aic8800-sdio=y
CONFIG_PACKAGE_aic8800-sdio-firmware=y
CONFIG_PACKAGE_aic8800-recovery=y
# CONFIG_AIC8800_SDIO_BT_SUPPORT is not set
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wireless-regdb=y

# The remote ImageBuilder and firmware share the exact signed APK feed.
CONFIG_IB=y
# CONFIG_IB_STANDALONE is not set
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_SIGN_EACH_PACKAGE=y
# Ship LuCI and both themes; Footstrap is selected in the stock config.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-a5e-board=y
# Optional packages for ImageBuilder and the published APK feed only.
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=m
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_kmod-usb-acm=m

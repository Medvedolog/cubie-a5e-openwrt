#!/bin/sh /etc/rc.common
# Single guarded check after boot. Not an always-on watchdog.
START=98
STOP=10
USE_PROCD=1

start_service() {
	config_load aic8800-recovery
	local enabled delay
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get delay main startup_delay 45
	case "$delay" in *[!0-9]*|'') delay=45 ;; esac
	[ "$delay" -ge 15 ] && [ "$delay" -le 300 ] || delay=45
	procd_open_instance
	procd_set_param command /usr/sbin/aic8800-auto-recover "$delay"
	procd_close_instance
}
